rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Deny every client request.
//
// The browser never reads or writes Firestore. All data flows through the
// Express API (server.ts), which verifies the Firebase ID token, scopes every
// query to req.auth.uid, enforces roles, credits and the device limit, and
// talks to Firestore through firebase-admin. The Admin SDK bypasses these
// rules, so the server keeps full access while direct client access, which
// would skip every server-side check, is refused.
//
// The previous per-collection rules allowed any signed-in Google account to
// list every user's resumes, sessions, transcripts, answers and notes, and to
// write sessions and answers directly, skipping credit charges.
//
// If a client feature ever needs direct Firestore access, add a narrow rule
// for that one path (owner-scoped get, owner-filtered list, validated write)
// with an emulator attack test, rather than reopening whole collections.
// ─────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
