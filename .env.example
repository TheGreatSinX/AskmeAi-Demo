# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Comma-separated rotation pool. The server round-robins over
# these keys: when one hits quota (429) it is cooled down and the next key is
# used immediately. SERVER-SIDE ONLY — never prefix with VITE_.
# GEMINI_API_KEYS="key-one,key-two,key-three"
# GEMINI_MODEL_FALLBACKS="gemini-3.5-flash,gemini-3.6-flash"
# GEMINI_MODEL="gemini-3.5-flash"

# BACKUP_AI_*: OpenAI-compatible provider used only when every Gemini key and
# model has failed. Rotate over its keys the same way. SERVER-SIDE ONLY.
# BACKUP_AI_URL="https://api-cdn.deploy.com/api/v1"
# BACKUP_AI_KEYS="secret-key-one,secret-key-two"
# BACKUP_AI_MODELS="zai-org/glm-5.3-flash,deepseek-ai/deepseek-v4.1-flash-1017"
# Reasoning effort for the backup models. "max" (their default) can spend the
# whole completion budget thinking; "low" answers in seconds. "" omits it.
# BACKUP_AI_REASONING_EFFORT="low"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Firebase — Client (Firebase Authentication)
# Vite inlines VITE_* variables into the browser bundle at dev/build time.
# Leave them empty to run the app in local demo mode (no sign-in screen).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Point the client at the local Auth emulator instead of production Firebase.
# VITE_FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"

# ---------------------------------------------------------------------------
# Firebase — Server (firebase-admin: Firestore + ID token verification)
# Pick ONE of the following credential styles:
#   1. FIREBASE_SERVICE_ACCOUNT  = raw JSON, base64 JSON, or a file path
#   2. GOOGLE_APPLICATION_CREDENTIALS = path to a service account JSON file
#   3. FIREBASE_PROJECT_ID only  = ambient credentials (Cloud Run / GCE)
# With no credentials at all the server falls back to data/database.json.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT=""

# DATA_BACKEND: force "file" to bypass Firestore even when credentials exist.
# DATA_BACKEND="file"

# SEED_DEMO_DATA: create a sample resume, knowledge doc and mock interview for
# every brand-new account ("false" to start accounts empty).
SEED_DEMO_DATA="true"
